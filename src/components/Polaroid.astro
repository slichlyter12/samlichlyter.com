---
import { Picture } from "astro:assets";
import profile from "../assets/profile.jpg";
import { site } from "../config";
---

<!-- Sizes are in design px via --u (see layout.css); the print is 297x297 on a 331x402 card. -->
<figure class="polaroid">
  <div class="print">
    <Picture
      src={profile}
      alt="Sam smiling, wearing a navy cap, glasses and a striped scarf"
      class="photo"
      formats={["avif", "webp"]}
      widths={[320, 640, 960]}
      sizes="(max-width: 1000px) 320px, calc(297 * max(100vw, 160vh) / 1440)"
      loading="eager"
      decoding="async"
    />
  </div>
  <figcaption class="caption">
    <h1>{site.name}</h1>
    <p>
      <span>{site.role}</span>
      <span>{site.company}</span>
    </p>
  </figcaption>
</figure>

<style>
  .polaroid {
    margin: 0;
    aspect-ratio: 331 / 402;
    background: #fbfbfa;
    border-radius: calc(2 * var(--u));
    box-shadow:
      0 calc(2 * var(--u)) calc(4 * var(--u)) #00000033,
      0 calc(26 * var(--u)) calc(44 * var(--u)) calc(-10 * var(--u)) #00000059;
  }

  .print {
    position: absolute;
    left: calc(17 * var(--u));
    top: calc(22 * var(--u));
    width: calc(297 * var(--u));
    height: calc(297 * var(--u));
    overflow: hidden;
  }

  .print :global(picture),
  .print :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .print :global(img) {
    object-fit: cover;
    object-position: 50% 6%;
  }

  /* Print gloss: diagonal sheen plus a slightly recessed edge. */
  .print::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #ffffff4d 0%, #ffffff00 40%, #00000026 100%);
    box-shadow: inset 0 calc(2 * var(--u)) calc(6 * var(--u)) #00000066;
    pointer-events: none;
  }

  .caption {
    position: absolute;
    left: calc(17 * var(--u));
    right: calc(17 * var(--u));
    top: calc(320 * var(--u));
    text-align: center;
    font-family: var(--font-hand);
    color: #1c1c1e;
  }

  h1 {
    margin: 0;
    font-size: calc(36 * var(--u));
    font-weight: 700;
    line-height: 1;
  }

  p {
    margin: calc(2 * var(--u)) 0 0;
    font-size: calc(19 * var(--u));
    font-weight: 500;
    line-height: 1.05;
    color: #1c1c1ecc;
  }

  span {
    display: block;
  }
</style>
