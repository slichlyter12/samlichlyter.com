---
import { Picture } from "astro:assets";
import desk from "../assets/desk.jpg";
import "../styles/layout.css";
---

<!--
  The desk photo is a flat render from Sketch (Round 8) without the Polaroid, glass
  panel, grain or colour grade. Those are live HTML/CSS layered on top.
-->
<div class="scene">
  <div class="stage" aria-hidden="true">
    <Picture
      src={desk}
      alt=""
      class="desk"
      formats={["avif", "webp"]}
      widths={[960, 1440, 1920, 2880]}
      sizes="max(100vw, 160vh)"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="content">
    <slot />
  </div>
  <div class="grade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>
</div>
