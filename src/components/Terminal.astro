---
import { site } from "../config";
import Icon from "./Icon.astro";
---

<section class="terminal" aria-labelledby="whoami">
  <p class="line"><span class="prompt" aria-hidden="true">$</span> whoami</p>
  <h1 id="whoami">{site.name}</h1>
  <p class="dim">{site.title}</p>

  <p class="line"><span class="prompt" aria-hidden="true">$</span> status</p>
  <p class="status">
    <strong>under construction</strong>
    <span class="bar" role="img" aria-label="Progress: about 30 percent"></span>
  </p>

  <p class="line"><span class="prompt" aria-hidden="true">$</span> ls links/</p>
  <ul>
    {
      site.links.map((link) => (
        <li>
          <a href={link.href} rel="me">
            <Icon icon={link.icon} />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="line">
    <span class="prompt" aria-hidden="true">$</span>
    <span class="cursor" aria-hidden="true"></span>
  </p>
</section>

<style>
  .terminal {
    width: min(100%, 34rem);
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--fg);
  }

  h1 {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  p,
  ul {
    margin: 0 0 0.25rem;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  a :global(svg) {
    margin-right: 0.4em;
    vertical-align: -0.125em;
  }

  .line {
    margin-top: 1.25rem;
  }

  .line:first-child {
    margin-top: 0;
  }

  .prompt,
  .dim {
    color: var(--fg-dim);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }

  /* 30% filled progress bar, pure CSS. */
  .bar {
    display: inline-block;
    width: 8rem;
    height: 0.75rem;
    border: 1px solid var(--fg);
    background: linear-gradient(to right, var(--fg) 30%, transparent 30%);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--fg);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
