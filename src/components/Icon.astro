---
import type { IconDefinition } from "@fortawesome/free-brands-svg-icons";

interface Props {
  icon: IconDefinition;
}

// Inline SVG from a Font Awesome icon definition; no client-side JS or CSS needed.
const [width, height, , , path] = Astro.props.icon.icon;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
>
  <path d={path as string}></path>
</svg>
